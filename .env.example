# Local Laser Stack (printed by ./scripts/up in the laser-stack checkout)
LASER_CONNECTION_STRING=iggy:laser@127.0.0.1:8090
# LaserData Cloud instead: user:password@your-deployment.laserdata.cloud (or token@host)

# LLM: claude (claude -p, the default when it is on PATH), api (needs ANTHROPIC_API_KEY) or mock
DESK_LLM=claude
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Seconds the resolver holds at the policy step so you can kill it mid-case (0 = off)
DESK_POLICY_PAUSE=0
# Chaos monkey: 1 kills a random agent every DESK_CHAOS_MIN to DESK_CHAOS_MAX seconds
DESK_CHAOS=0
DESK_CHAOS_AGENTS=triage,resolver,billing
DESK_CHAOS_MIN=1
DESK_CHAOS_MAX=10
# Demo loop: 1 runs every scenario in turn, forever, on the mock LLM
DESK_DEMO=0
DESK_DEMO_PAUSE=8
DESK_DEMO_APPROVE_DELAY=3
DESK_DEMO_STEP=0.8
DESK_DEMO_LLM=mock
# Traces: set to 0 to turn off
DESK_OTEL=1
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
DESK_PORT=8000
